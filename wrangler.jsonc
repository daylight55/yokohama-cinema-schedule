{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yokohama-cinema-schedule",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-07-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yokohama-cinema-schedule",
      "database_id": "e657eee0-8431-4641-a5b9-bd08cb70d191",
      "migrations_dir": "./migrations"
    }
  ],
  "vars": {
    "APP_ORIGIN": "https://hama-movie.daylight55.dev",
    "PUBLIC_MODE": "false",
    "SESSION_TTL_DAYS": "30",
    "INVITE_FROM_EMAIL": "noreply@notify.daylight55.dev"
  },
  "services": [
    {
      "binding": "INVITE_MAILER",
      "service": "yokohama-cinema-schedule-mail"
    }
  ]
}
