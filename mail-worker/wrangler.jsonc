{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "yokohama-cinema-schedule-mail",
  "main": "index.ts",
  "compatibility_date": "2026-09-25",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
      "head_sampling_rate": 1
    }
  },
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "vars": {
    "APP_ORIGIN": "https://hama-movie.daylight55.dev",
    "INVITE_FROM_EMAIL": "noreply@notify.daylight55.dev"
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yokohama-cinema-schedule",
      "database_id": "e657eee0-8431-4641-a5b9-bd08cb70d191",
      "migrations_dir": "../migrations"
    }
  ]
}
