{
  "name": "yokohama-cinema-schedule",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "ci:pr": "npm run guide:check && npm run typecheck && npm run test && npm run test:worker-runtime && npm run build",
    "pages:dev": "npm run build && wrangler pages dev dist --persist-to .wrangler/state",
    "pages:deploy": "npm run build && wrangler pages deploy dist",
    "worker:dev": "wrangler dev --config worker/wrangler.jsonc --persist-to .wrangler/state",
    "worker:deploy": "wrangler deploy --config worker/wrangler.jsonc",
    "db:migrate:local": "wrangler d1 migrations apply yokohama-cinema-schedule --local --config worker/wrangler.jsonc --persist-to .wrangler/state",
    "db:migrate:remote": "wrangler d1 migrations apply yokohama-cinema-schedule --remote --config worker/wrangler.jsonc",
    "ci:pr:clean": "bash scripts/ci-pr-clean.sh",
    "test:worker-runtime": "node scripts/worker-runtime-smoke.mjs",
    "perf:benchmark": "node --experimental-strip-types scripts/frontend-performance.mjs",
    "test:performance": "vitest run test/frontend-performance.test.ts test/history-scroll.test.mjs",
    "sync:schedules": "node scripts/sync-schedules.mjs",
    "guide:check": "node scripts/site-guide/freshness.mjs check",
    "guide:review": "node scripts/site-guide/freshness.mjs review"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@simplewebauthn/server": "^13.3.2",
    "cheerio": "^1.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260723.1",
    "@types/node": "^22.20.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "happy-dom": "^20.14.5",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wrangler": "^4.113.0",
    "esbuild": "0.28.1"
  },
  "overrides": {
    "sharp": "^0.35.3"
  }
}
